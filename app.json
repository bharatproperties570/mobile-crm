{
  "expo": {
    "name": "Bharat Properties CRM",
    "slug": "bharat-properties-crm-mobile",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/custom-icon.png",
    "scheme": "bharatproperties",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121212",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bharatproperties.crm",
      "backgroundColor": "#121212",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIUserInterfaceStyle": "Dark"
      }
    },
    "android": {
      "package": "com.bharatproperties.crm",
      "backgroundColor": "#121212",
      "softwareKeyboardLayoutMode": "resize",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBd2gdMJVt5C_tgYqWoRbBiatzmevYdB9U"
        }
      },
      "permissions": [
        "READ_CALL_LOG",
        "READ_PHONE_STATE",
        "READ_CONTACTS",
        "SYSTEM_ALERT_WINDOW",
        "FOREGROUND_SERVICE",
        "CALL_PHONE",
        "android.permission.BIND_TELECOM_CONNECTION_SERVICE",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/custom-icon.png",
        "backgroundColor": "#121212"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Bharat Properties to sync with your calendar."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Bharat Properties CRM to access your contacts to easily add leads."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      "./plugins/withCallKeep"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4f6775c-5192-495f-a493-6af01be6995c"
      }
    },
    "owner": "realdeal570"
  }
}
